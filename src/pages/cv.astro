---
import BaseLayout from '../layouts/BaseLayout.astro';

const profileImage = "https://ui-avatars.com/api/?name=Muhammad+Komar&size=256&background=2563eb&color=fff&bold=true";

const skills = [
  'React.js', 'Next.js', 'TypeScript', 'JavaScript ES6+',
  'Tailwind CSS', 'HTML5', 'CSS3', 'REST API',
  'Supabase', 'Firebase', 'WordPress', 'Git'
];

const experience = [
  {
    company: 'Kreatif Infotek Global',
    role: 'Frontend Developer',
    period: '2019 - 2026',
    description: 'Developed responsive web applications using React.js. Integrated third-party services (Airtable, CRM APIs). Improved performance, SEO, and mobile responsiveness.'
  },
  {
    company: 'Upword Technologies',
    role: 'Web Developer (WordPress & Frontend)',
    period: '2013 - 2019',
    description: 'Developed custom WordPress themes and plugins. Built web applications for multiple clients. Focused on frontend implementation and usability.'
  }
];

const projects = [
  { name: 'SKCK Online Dashboard', client: 'Baintelkam Polri', tech: 'Next.js, React, TypeScript' },
  { name: 'TCMMP Mini Program', client: 'Telkomsel Cloud Photo', tech: 'JavaScript, Tencent Cloud' },
  { name: 'ArkoPay', client: 'ArkoPay', tech: 'Next.js, Airtable', link: 'https://arkopay.com' },
  { name: 'Next Steps Idaho', client: 'Idaho Government', tech: 'Next.js, React', link: 'https://nextsteps.idaho.gov' },
  { name: 'Frogsxy Platform', client: 'Frogsxy', tech: 'React, Next.js, SSR/SSG', link: 'https://frogsxy.com' }
];
---

<BaseLayout
  title="CV - Muhammad Komar"
  description="Resume of Muhammad Komar - Frontend Engineer with 6+ years experience in React.js and Next.js"
  canonicalPath="/cv"
>
  <div class="max-w-4xl mx-auto px-4 md:px-6 py-8 md:py-12">
    <!-- Print Header -->
    <div class="hidden print:block mb-6">
      <h1 class="text-2xl font-bold">Muhammad Komar - CV</h1>
      <p class="text-sm text-gray-600">Generated on {new Date().toLocaleDateString()}</p>
    </div>

    <!-- Header -->
    <div class="flex flex-col md:flex-row gap-6 mb-8">
      <img
        src={profileImage}
        alt="Muhammad Komar"
        width="120"
        height="120"
        class="w-24 h-24 rounded-full border-4 border-gray-200 dark:border-gray-800 flex-shrink-0"
      />
      <div>
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-2">Muhammad Komar</h1>
        <p class="text-xl text-gray-600 dark:text-gray-300 mb-3">Frontend Engineer (React.js / Next.js)</p>
        <div class="flex flex-wrap gap-2 text-sm text-gray-500 dark:text-gray-400">
          <span>muh.komar@gmail.com</span>
          <span class="hidden md:inline">|</span>
          <span>081717889797</span>
          <span class="hidden md:inline">|</span>
          <span>Bogor, Indonesia</span>
        </div>
        <div class="flex gap-3 mt-4">
          <a href="https://github.com/mkom" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline text-sm">GitHub</a>
          <a href="/cv" class="text-gray-500 dark:text-gray-400 text-sm print:hidden">EN</a>
          <a href="/id/cv" class="text-gray-500 dark:text-gray-400 text-sm print:hidden">ID</a>
        </div>
      </div>
    </div>

    <!-- Summary -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 pb-2 border-b border-gray-200 dark:border-gray-700">Professional Summary</h2>
      <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
        Frontend Engineer with 6+ years of experience building scalable, responsive, and user-focused web applications using React.js and Next.js. Proven track record in developing production-level applications, optimizing performance, and collaborating with cross-functional teams to deliver high-quality digital products.
      </p>
    </section>

    <!-- Skills -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 pb-2 border-b border-gray-200 dark:border-gray-700">Technical Skills</h2>
      <div class="flex flex-wrap gap-2">
        {skills.map((skill) => (
          <span class="px-3 py-1 bg-gray-100 dark:bg-gray-900 text-gray-700 dark:text-gray-300 text-sm rounded">
            {skill}
          </span>
        ))}
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 pb-2 border-b border-gray-200 dark:border-gray-700">Work Experience</h2>
      <div class="space-y-6">
        {experience.map((job) => (
          <div>
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline mb-2">
              <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{job.company}</h3>
              <span class="text-sm text-gray-500 dark:text-gray-400">{job.period}</span>
            </div>
            <p class="text-gray-600 dark:text-gray-400 mb-2">{job.role}</p>
            <p class="text-gray-600 dark:text-gray-400 text-sm">{job.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 pb-2 border-b border-gray-200 dark:border-gray-700">Selected Projects</h2>
      <div class="space-y-4">
        {projects.map((project) => (
          <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2">
            <div>
              <h3 class="font-medium text-gray-900 dark:text-white">{project.name}</h3>
              <p class="text-sm text-gray-500 dark:text-gray-400">{project.client}</p>
              <p class="text-sm text-gray-600 dark:text-gray-400">{project.tech}</p>
            </div>
            {project.link && (
              <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline text-sm whitespace-nowrap">
                Visit Site
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Education -->
    <section class="mb-8">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-3 pb-2 border-b border-gray-200 dark:border-gray-700">Education</h2>
      <div>
        <h3 class="font-medium text-gray-900 dark:text-white">Bachelor of Information Technology</h3>
        <p class="text-gray-600 dark:text-gray-400">Muhammadiah University of Purwokerto | 2007 - 2012</p>
        <p class="text-sm text-gray-500 dark:text-gray-400">Software Development</p>
      </div>
    </section>

    <!-- Print Button -->
    <div class="print:hidden flex justify-center gap-4">
      <button
        onclick="window.print()"
        class="inline-flex items-center px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
        </svg>
        Save as PDF
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  @media print {
    body { background: white; }
    header, footer { display: none; }
    main { padding: 0; }
  }
</style>