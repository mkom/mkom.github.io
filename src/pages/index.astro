---
import BaseLayout from '../layouts/BaseLayout.astro';

const profileImage = "/muhammad_komar.jpg";
---

<BaseLayout
  title="Muhammad Komar - Frontend Engineer"
  description="Frontend Engineer with 6+ years experience building scalable web applications with React.js and Next.js. Based in Bogor, Indonesia."
>
  <section class="max-w-4xl mx-auto px-6 py-12 md:py-20">
    <div class="flex flex-col md:flex-row items-start gap-8">
      <img
        src={profileImage}
        alt="Muhammad Komar"
        width="128"
        height="128"
        class="w-24 h-24 md:w-32 md:h-32 rounded-full border-4 border-gray-200 dark:border-gray-800"
        loading="eager"
      />
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Hello, I'm</p>
        <h1 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-2">
          Muhammad Komar
        </h1>
        <h2 class="text-xl md:text-2xl text-gray-600 dark:text-gray-300 mb-4">
          Frontend Engineer (React.js / Next.js)
        </h2>
        <p class="text-base md:text-lg text-gray-600 dark:text-gray-400 max-w-xl mb-6">
          Frontend Engineer with 6+ years of experience building scalable, high-performance web applications. Specialized in modern frontend architecture, Programmatic SEO (PGSEO), and user-focused interfaces.
        </p>
        <div class="flex flex-wrap gap-3">
          <a
            href="/projects"
            class="inline-flex items-center px-5 py-2.5 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-medium rounded-lg hover:bg-gray-800 dark:hover:bg-gray-100 transition-colors text-sm"
          >
            View Projects
          </a>
          <a
            href="/contact"
            class="inline-flex items-center px-5 py-2.5 border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-900 transition-colors text-sm"
          >
            Get in Touch
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-12 border-t border-gray-200 dark:border-gray-800">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6">Tech Stack</h3>
    <div class="flex flex-wrap gap-2">
      {['React.js', 'Next.js', 'WordPress', 'TypeScript', 'JavaScript', 'Tailwind CSS', 'Astro'].map((tech) => (
        <span class="px-4 py-2 bg-gray-100 dark:bg-gray-900 text-gray-700 dark:text-gray-300 rounded-full text-sm font-medium">
          {tech}
        </span>
      ))}
    </div>
  </section>
</BaseLayout>