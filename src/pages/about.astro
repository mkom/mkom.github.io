---
import BaseLayout from '../layouts/BaseLayout.astro';

const profileImage = "/muhammad_komar.jpg";

const skills = [
  'React.js', 'Next.js', 'JavaScript ES6+', 'TypeScript',
  'Tailwind CSS', 'HTML5', 'CSS3', 'PHP',
  'REST API', 'Supabase', 'Firebase', 'Airtable',
  'WordPress', 'Git', 'Vercel', 'Docker', 'Nginx'
];

const experience = [
  {
    company: 'Kreatif Infotek Global',
    role: 'Frontend Developer',
    period: '2019 - 2026',
    points: [
      'Developed responsive and scalable web applications using React.js',
      'Integrated third-party services such as Airtable and CRM APIs',
      'Improved website performance, SEO structure, and mobile responsiveness',
      'Collaborated with UI/UX designers and backend engineers'
    ]
  },
  {
    company: 'Upword Technologies',
    role: 'Web Developer (WordPress & Frontend)',
    period: '2013 - 2019',
    points: [
      'Developed and maintained custom WordPress themes and plugins',
      'Built and enhanced web applications for multiple clients',
      'Focused on frontend implementation and usability improvements'
    ]
  }
];
---

<BaseLayout
  title="About - Muhammad Komar"
  description="Learn more about Muhammad Komar, a Frontend Engineer with 6+ years of experience in React.js and Next.js. Based in Bogor, Indonesia."
>
  <section class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-8">About Me</h1>

    <div class="flex flex-col md:flex-row gap-8 mb-12">
      <img
        src={profileImage}
        alt="Muhammad Komar"
        width="160"
        height="160"
        class="w-32 h-32 rounded-full border-4 border-gray-200 dark:border-gray-800 flex-shrink-0"
        loading="lazy"
      />
      <div class="prose dark:prose-invert max-w-none">
        <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-2">
         I focus on building scalable, maintainable, and performance-driven frontend systems using modern technologies like React.js and Next.js.
        </p>
        <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-2">
         I have strong experience delivering production-ready applications, optimizing performance, and collaborating with cross-functional teams to build impactful digital products.
        </p>
        <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-2">
         In addition, I have experience integrating and extending CMS platforms such as WordPress to support content-driven applications.
        </p>
      </div>
    </div>

    <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Skills</h2>
    <div class="flex flex-wrap gap-2 mb-12">
      {skills.map((skill) => (
        <span class="px-4 py-2 bg-gray-100 dark:bg-gray-900 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium">
          {skill}
        </span>
      ))}
    </div>

    <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-6">Work Experience</h2>
    <div class="space-y-8">
      {experience.map((job) => (
        <div class="border-l-2 border-gray-200 dark:border-gray-700 pl-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-2 gap-2">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{job.company}</h3>
            <span class="text-sm text-gray-500 dark:text-gray-400">{job.period}</span>
          </div>
          <p class="text-gray-600 dark:text-gray-400 mb-3">{job.role}</p>
          <ul class="space-y-2">
            {job.points.map((point) => (
              <li class="text-gray-600 dark:text-gray-400 text-sm">{point}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 p-6 bg-gray-50 dark:bg-gray-900 rounded-lg">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Education</h3>
      <p class="text-gray-600 dark:text-gray-400">Bachelor of Information Technology (Software Development)</p>
      <p class="text-gray-500 dark:text-gray-400 text-sm">Muhammadiah University of Purwokerto | 2007 - 2012</p>
    </div>
  </section>
</BaseLayout>